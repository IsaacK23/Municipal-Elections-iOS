rules_version = '2';

// Firestore security rules for the Municipal Elections Companion (COMP4977 A2).
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
// Every user is identified by their (lowercase) Firebase Auth email.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }

    // UserProfiles/{email}: the user's municipality. Only the owner can read or write it.
    match /UserProfiles/{email} {
      allow read, write: if signedIn() && email == myEmail();
    }

    // CandidateSelections/{id}: one saved candidate. Users can only see, change or delete
    // their own selections, and the server re-checks the fields (including notes <= 500).
    match /CandidateSelections/{selectionId} {
      function validSelection(data) {
        return data.userEmail == myEmail()
          && data.candidateId is int
          && data.positionId is int
          && data.municipalityId is int
          && data.candidateName is string && data.candidateName.size() > 0
          && data.positionName is string
          && data.municipalityName is string
          && data.notes is string && data.notes.size() <= 500;
      }

      allow read, delete: if signedIn() && resource.data.userEmail == myEmail();
      allow create: if signedIn() && validSelection(request.resource.data);
      allow update: if signedIn()
                    && resource.data.userEmail == myEmail()
                    && request.resource.data.userEmail == resource.data.userEmail
                    && validSelection(request.resource.data);
    }
  }
}
